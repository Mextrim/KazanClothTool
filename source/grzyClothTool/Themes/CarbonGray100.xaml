<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Shared.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        IBM Carbon Design System - Gray 100 theme (Figma Community kit by Phil Cole).
        The name comes from the gray-100 base layer #262626: monochrome dark UI, white
        interactive elements, Carbon layer ladder and strictly square geometry.
    -->

    <!-- Carbon geometry: square controls, 2/4/8 px only for containers. -->
    <CornerRadius x:Key="RadiusXs">0</CornerRadius>
    <CornerRadius x:Key="RadiusSm">0</CornerRadius>
    <CornerRadius x:Key="RadiusMd">0</CornerRadius>
    <CornerRadius x:Key="RadiusLg">2</CornerRadius>
    <CornerRadius x:Key="RadiusXl">4</CornerRadius>
    <CornerRadius x:Key="RadiusXxl">8</CornerRadius>

    <DropShadowEffect x:Key="ElevationLow" BlurRadius="12" ShadowDepth="2" Opacity="0.20" Color="#000000" />
    <DropShadowEffect x:Key="ElevationMedium" BlurRadius="20" ShadowDepth="4" Opacity="0.26" Color="#000000" />
    <DropShadowEffect x:Key="ElevationHigh" BlurRadius="28" ShadowDepth="8" Opacity="0.34" Color="#000000" />

    <Color x:Key="Color50">#262626</Color>
    <Color x:Key="Color75">#2C2C2C</Color>
    <Color x:Key="Color100">#333333</Color>
    <Color x:Key="Color125">#383838</Color>
    <Color x:Key="Color150">#393939</Color>
    <Color x:Key="Color175">#3F3F3F</Color>
    <Color x:Key="Color200">#454545</Color>
    <Color x:Key="Color250">#525252</Color>
    <Color x:Key="Color300">#6F6F6F</Color>
    <Color x:Key="Color350">#8D8D8D</Color>
    <Color x:Key="Color400">#A8A8A8</Color>
    <Color x:Key="Color450">#C6C6C6</Color>
    <Color x:Key="Color500">#D6D6D6</Color>
    <Color x:Key="Color600">#E0E0E0</Color>
    <Color x:Key="Color700">#E8E8E8</Color>
    <Color x:Key="Color800">#F0F0F0</Color>
    <Color x:Key="Color900">#F4F4F4</Color>
    <Color x:Key="Color950">#FFFFFFFF</Color>

    <!-- Gray 100 keeps the interface monochrome: white is the interactive color. -->
    <Color x:Key="ColorAccent">#FFFFFF</Color>
    <Color x:Key="ColorAccentHover">#E0E0E0</Color>
    <Color x:Key="ColorAccentPressed">#CCCCCC</Color>
    <Color x:Key="ColorAccentDim">#353535</Color>
    <Color x:Key="ColorOnPrimary">#161616</Color>
    <Color x:Key="ColorViewport">#FF262626</Color>
    <Color x:Key="ColorSecondary">#4589FF</Color>
    <Color x:Key="ColorSecondaryHover">#78A9FF</Color>
    <Color x:Key="ColorSecondaryDim">#1B2A47</Color>
    <Color x:Key="ColorSuccess">#42BE65</Color>
    <Color x:Key="ColorWarning">#F1C21B</Color>
    <Color x:Key="ColorDanger">#FF8389</Color>

    <SolidColorBrush x:Key="Brush50" Color="{StaticResource Color50}" />
    <SolidColorBrush x:Key="Brush75" Color="{StaticResource Color75}" />
    <SolidColorBrush x:Key="Brush100" Color="{StaticResource Color100}" />
    <SolidColorBrush x:Key="Brush125" Color="{StaticResource Color125}" />
    <SolidColorBrush x:Key="Brush150" Color="{StaticResource Color150}" />
    <SolidColorBrush x:Key="Brush175" Color="{StaticResource Color175}" />
    <SolidColorBrush x:Key="Brush200" Color="{StaticResource Color200}" />
    <SolidColorBrush x:Key="Brush250" Color="{StaticResource Color250}" />
    <SolidColorBrush x:Key="Brush300" Color="{StaticResource Color300}" />
    <SolidColorBrush x:Key="Brush350" Color="{StaticResource Color350}" />
    <SolidColorBrush x:Key="Brush400" Color="{StaticResource Color400}" />
    <SolidColorBrush x:Key="Brush450" Color="{StaticResource Color450}" />
    <SolidColorBrush x:Key="Brush500" Color="{StaticResource Color500}" />
    <SolidColorBrush x:Key="Brush600" Color="{StaticResource Color600}" />
    <SolidColorBrush x:Key="Brush700" Color="{StaticResource Color700}" />
    <SolidColorBrush x:Key="Brush800" Color="{StaticResource Color800}" />
    <SolidColorBrush x:Key="Brush900" Color="{StaticResource Color900}" />
    <SolidColorBrush x:Key="Brush950" Color="{StaticResource Color950}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource ColorAccent}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource ColorAccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource ColorAccentPressed}" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource ColorAccentDim}" />
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource ColorOnPrimary}" />
    <SolidColorBrush x:Key="ViewportBackgroundBrush" Color="{StaticResource ColorViewport}" />
    <SolidColorBrush x:Key="ViewportForegroundBrush" Color="#A8A8A8" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource ColorSecondary}" />
    <SolidColorBrush x:Key="SecondaryHoverBrush" Color="{StaticResource ColorSecondaryHover}" />
    <SolidColorBrush x:Key="SecondaryDimBrush" Color="{StaticResource ColorSecondaryDim}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource ColorSuccess}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource ColorWarning}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource ColorDanger}" />

    <SolidColorBrush x:Key="White" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Black" Color="#FF000000" />
    <SolidColorBrush x:Key="GroupBoxBorder" Color="{StaticResource Color300}" />
</ResourceDictionary>
