<UserControl x:Class="grzyClothTool.Controls.CustomButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             x:Name="MyCustomButton"
             d:Height="40"
             d:Width="220"
             mc:Ignorable="d">
    <Grid>
        <Border x:Name="ButtonSurface"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="{Binding CornerRadius, ElementName=MyCustomButton}">
            <Button HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Center"
                    FontFamily="{DynamicResource AppFontFamily}"
                    FontWeight="SemiBold"
                    FontSize="{Binding FontSize, ElementName=MyCustomButton}"
                    Foreground="{DynamicResource Brush950}"
                    ToolTip="{Binding Tooltip, ElementName=MyCustomButton}"
                    ToolTipService.InitialShowDelay="250"
                    Click="Button_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="{DynamicResource Brush150}" />
                        <Setter Property="BorderBrush" Value="{DynamicResource Brush350}" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="Padding" Value="12,0,38,0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="CustomButtonBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{Binding CornerRadius, ElementName=MyCustomButton}">
                                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding DropdownEnabled, ElementName=MyCustomButton}" Value="True">
                                            <Setter TargetName="CustomButtonBorder" Property="BorderThickness" Value="1,1,0,1" />
                                            <Setter TargetName="CustomButtonBorder" Property="CornerRadius" Value="9,0,0,9" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="CustomButtonBorder" Property="Background" Value="{DynamicResource Brush200}" />
                                            <Setter TargetName="CustomButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="CustomButtonBorder" Property="Background" Value="{DynamicResource Brush250}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="CustomButtonBorder" Property="Background" Value="{DynamicResource Brush175}" />
                                            <Setter TargetName="CustomButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Opacity" Value="{DynamicResource DisabledOpacity}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DropdownEnabled, ElementName=MyCustomButton}" Value="False">
                                <Setter Property="Padding" Value="12,0" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <fa:IconBlock Icon="{Binding FaIcon, ElementName=MyCustomButton}"
                                  IconFont="Solid"
                                  Width="18"
                                  Height="18"
                                  Margin="0,0,8,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Label, ElementName=MyCustomButton}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="{Binding FontSize, ElementName=MyCustomButton}"
                                   FontWeight="SemiBold"
                                   LineHeight="14"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SecondaryLabel, ElementName=MyCustomButton}"
                                   FontFamily="{DynamicResource AppFontFamily}"
                                   FontSize="8"
                                   FontWeight="SemiBold"
                                   Opacity="0.72"
                                   LineHeight="10"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
            </Button>
        </Border>

        <ToggleButton x:Name="DropdownToggle"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Center"
                      Width="34"
                      Height="{Binding ActualHeight, ElementName=ButtonSurface}"
                      Background="Transparent"
                      BorderThickness="0"
                      Cursor="Hand"
                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="DropdownSurface"
                            Background="Transparent"
                            BorderBrush="{DynamicResource Brush400}"
                            BorderThickness="1,1,1,1"
                            CornerRadius="0,9,9,0">
                        <fa:IconBlock Icon="ChevronDown"
                                      IconFont="Solid"
                                      Width="12"
                                      Height="12"
                                      Foreground="{DynamicResource Brush600}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="DropdownSurface" Property="Background" Value="{DynamicResource Brush175}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="DropdownSurface" Property="Background" Value="{DynamicResource Brush200}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <ToggleButton.Style>
                <Style TargetType="ToggleButton">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding DropdownEnabled, ElementName=MyCustomButton}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ToggleButton.Style>
        </ToggleButton>

        <Popup Width="250"
               PlacementTarget="{Binding ElementName=ButtonSurface}"
               Placement="Top"
               VerticalOffset="-4"
               StaysOpen="False"
               IsOpen="{Binding IsChecked, ElementName=DropdownToggle}"
               AllowsTransparency="True">
            <Border Width="250"
                    MinWidth="250"
                    Margin="0,0,0,4"
                    Padding="4"
                    Background="{DynamicResource Brush100}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="5" Opacity="0.45" Color="Black" />
                </Border.Effect>
                <ContentPresenter x:Name="DropdownContentPresenter"
                                  HorizontalAlignment="Stretch"
                                  Content="{Binding DropdownContent, ElementName=MyCustomButton}" />
            </Border>
        </Popup>
    </Grid>
</UserControl>
