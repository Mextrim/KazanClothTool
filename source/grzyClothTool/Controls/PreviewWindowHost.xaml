<UserControl x:Class="grzyClothTool.Controls.PreviewWindowHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             mc:Ignorable="d"
             d:DesignHeight="600"
             d:DesignWidth="500"
             Background="{DynamicResource Brush50}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush300}"
                BorderThickness="0,0,0,1">
            <Grid Margin="12,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Width="27"
                        Height="27"
                        Background="{DynamicResource AccentDimBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <icons:MaterialIcon Kind="Rotate3d" Width="16" Height="16" Foreground="{DynamicResource AccentBrush}" />
                </Border>

                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="3D-ПРЕДПРОСМОТР" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush950}" />
                    <TextBlock Text="Мышь — вращение · колесо — масштаб" FontSize="9" Foreground="{DynamicResource Brush600}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Width="34"
                        Height="32"
                        Padding="0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ClosePreview_Click"
                        ToolTip="Закрыть 3D-предпросмотр"
                         AutomationProperties.Name="Закрыть 3D-предпросмотр">
                    <icons:MaterialIcon Kind="Close" Width="17" Height="17" Foreground="{DynamicResource Brush600}" />
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{DynamicResource ViewportBackgroundBrush}">
            <WindowsFormsHost x:Name="PreviewHost" />
            <StackPanel x:Name="PlaceholderPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        IsHitTestVisible="False">
                <icons:MaterialIcon Kind="BoxOutline" Width="46" Height="46" Foreground="{DynamicResource ViewportForegroundBrush}" HorizontalAlignment="Center" />
                <TextBlock x:Name="PlaceholderText"
                           Text="3D-модель появится здесь"
                           Margin="0,14,0,0"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource ViewportForegroundBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Выберите одежду слева или перетащите YDD в список"
                           Margin="0,6,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource ViewportForegroundBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="280" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
