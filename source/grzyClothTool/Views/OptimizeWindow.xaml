<Window x:Class="grzyClothTool.Views.OptimizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        xmlns:local="clr-namespace:grzyClothTool.Views"
        xmlns:c="clr-namespace:grzyClothTool.Controls"
        xmlns:converters="clr-namespace:grzyClothTool.Converters"
        Background="{DynamicResource Brush50}"
        mc:Ignorable="d"
        Title="Оптимизация текстур" MinHeight="420" MaxHeight="420" MinWidth="690" MaxWidth="690">
    <Window.Resources>
        <converters:CompressionFormatConverter x:Key="CompressionFormatConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="10" />
            <ColumnDefinition Width="330" />
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="130" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <GroupBox Header="Текущая текстура" Margin="5" Grid.Row="0" Style="{DynamicResource FixedGroupBox}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Название: " />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding TextureName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MultipleTexturesSelected}" Value="True">
                                            <Setter Property="Text" Value="{Binding SelectedTextureCount, StringFormat='Выбрано текстур: {0}'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Сжатие: " />
                        <TextBlock Text="{Binding TextureDetails.Compression, Converter={StaticResource CompressionFormatConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ширина: " />
                        <TextBlock Text="{Binding TextureDetails.Width}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Высота: " />
                        <TextBlock Text="{Binding TextureDetails.Height}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество мип-уровней: " />
                        <TextBlock Text="{Binding TextureDetails.MipMapCount}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="1" Margin="0,15,0,0" >

                <c:ModernLabelCheckBox
                    Label="Уменьшить размер текстуры"
                    IsChecked="{Binding IsTextureDownsizeEnabled}"
                    
    
                    />
                <c:ModernLabelComboBox
                    IsEnabled="{Binding IsTextureDownsizeEnabled}"
                    Label="Выбрать размер текстуры"
                    SelectedItem="{Binding SelectedTextureSize}"
                    ItemsSource="{Binding AvailableTextureSizes}"
                    />
            </StackPanel>

            <StackPanel Grid.Row="2" Width="320" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTextureDownsizeEnabled}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <icons:MaterialIcon Kind="WarningBoxOutline" Width="40" Height="40" Foreground="{DynamicResource Brush950}" />
                <TextBlock Width="280" FontWeight="Medium" Foreground="{DynamicResource Brush950}" Text="Изменение размера текстуры здесь ухудшит качество. Чтобы сохранить качество, выполняйте эту операцию в 3D-программах с запеканием текстур." TextWrapping="WrapWithOverflow" FontSize="12"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Column="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="130" />
                <RowDefinition Height="*" />
                <RowDefinition Height="70" />
            </Grid.RowDefinitions>
            <GroupBox Header="Выходная текстура" Margin="5" Grid.Row="0" Style="{DynamicResource FixedGroupBox}">
                <StackPanel Orientation="Vertical">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Название: " />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding TextureName}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding MultipleTexturesSelected}" Value="True">
                                            <Setter Property="Text" Value="{Binding SelectedTextureCount, StringFormat='Выбрано текстур: {0}'}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Сжатие: " />
                        <TextBlock Text="{Binding OutputTextureDetails.Compression, Converter={StaticResource CompressionFormatConverter}}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Ширина: " />
                        <TextBlock Text="{Binding OutputTextureDetails.Width}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Высота: " />
                        <TextBlock Text="{Binding OutputTextureDetails.Height}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Количество мип-уровней: " />
                        <TextBlock Text="{Binding OutputTextureDetails.MipMapCount}" />
                    </StackPanel>
                </StackPanel>
            </GroupBox>
            <StackPanel Grid.Row="1" Margin="0,15,0,0">
                <c:ModernLabelCheckBox
                    IsChecked="{Binding IsTextureCompressionEnabled}"
                    Label="Изменить сжатие текстуры"
    
                    />
                <c:ModernLabelComboBox
                    IsEnabled="{Binding IsTextureCompressionEnabled}"
                    Label="Выбрать сжатие"
                    ItemsSource="{Binding AvailableCompression}"
                    SelectedItem="{Binding SelectedCompression}"
                    />
            </StackPanel>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
                <c:CustomButton 
                    x:Name="cancel"
                    Margin="5"
                    CornerRadius="5"
                    Height="40"
                    Width="100"
                    Label="Отмена"
                    MyBtnClickEvent="CancelBtn_Click"
                />
                <c:CustomButton 
                    Margin="5"
                    x:Name="build"
                    CornerRadius="5"
                    Height="40"
                    Width="180"
                    Label="Оптимизировать"
                    MyBtnClickEvent="OptimizeTexture_Click"
                />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
