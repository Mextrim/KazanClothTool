<UserControl x:Class="grzyClothTool.Views.ProjectWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:grzyClothTool.Controls"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:models="clr-namespace:grzyClothTool.Models"
             d:DataContext="{d:DesignInstance Type=models:AddonManagerDesign, IsDesignTimeCreatable=True}"
             d:Width="1280"
             d:Height="760"
             mc:Ignorable="d"
             Background="{DynamicResource Brush50}"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">

    <UserControl.Resources>
        <Style x:Key="AddonTabStyle" TargetType="TabItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource Brush100}"
                                BorderBrush="{DynamicResource Brush300}"
                                BorderThickness="0,0,0,2"
                                CornerRadius="8,8,0,0"
                                Padding="12,8"
                                Margin="0,0,4,0">
                            <TextBlock x:Name="TabText"
                                       Text="{TemplateBinding Header}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush700}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush50}" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="TabText" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Brush150}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PanelButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="{DynamicResource Brush150}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush900}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush350}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PanelButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="PanelButtonBorder" Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PanelButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="PanelButtonBorder" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentPanelButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentPressedBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerIconButtonStyle" TargetType="Button" BasedOn="{StaticResource PanelButtonStyle}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Brush100}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush300}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush600}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush200}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Brush250}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FolderMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="Background" Value="{DynamicResource Brush75}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush800}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush350}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontFamily" Value="{DynamicResource DisplayFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="FolderMenuBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FolderMenuBorder" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                <Setter TargetName="FolderMenuBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FolderMenuBorder" Property="Background" Value="{DynamicResource Brush200}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FolderMenuBorder" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
        </Grid.RowDefinitions>

        <Border Grid.Column="0"
                Grid.Row="0"
                Grid.RowSpan="2"
                Background="{DynamicResource Brush75}"
                BorderBrush="{DynamicResource Brush250}"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="70" />
                </Grid.RowDefinitions>

                <TabControl x:Name="AddonTabControl"
                            Grid.Row="0"
                            ItemsSource="{Binding Addons}"
                            SelectedIndex="0"
                            SelectedItem="{Binding SelectedAddon}"
                            SelectionChanged="TabControl_SelectionChanged"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,8,8,0">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem" BasedOn="{StaticResource AddonTabStyle}" />
                    </TabControl.ItemContainerStyle>
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ScrollViewer Grid.Row="0"
                                              HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="True">
                                    <StackPanel IsItemsHost="True" Orientation="Horizontal" />
                                </ScrollViewer>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource Brush50}"
                                        BorderBrush="{DynamicResource Brush300}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Margin="0,10,8,8">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid AllowDrop="True"
                                  Drop="DrawablesGroupBox_Drop"
                                  DragEnter="DrawablesGroupBox_DragEnter"
                                  DragOver="DrawablesGroupBox_DragOver"
                                  DragLeave="DrawablesGroupBox_DragLeave">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0"
                                        Background="{DynamicResource Brush75}"
                                        BorderBrush="{DynamicResource Brush250}"
                                        BorderThickness="0,0,0,1"
                                        CornerRadius="11,11,0,0"
                                        Padding="10,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <icons:MaterialIcon Kind="Hanger" Width="17" Height="17" Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Text="ОДЕЖДА" Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush700}" />
                                        </StackPanel>

                                        <Border Grid.Column="1"
                                                Margin="10,7"
                                                Background="{DynamicResource Brush50}"
                                                BorderBrush="{DynamicResource Brush300}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <icons:MaterialIcon Grid.Column="0" Kind="Magnify" Width="15" Height="15" Foreground="{DynamicResource Brush500}" Margin="8,0,4,0" VerticalAlignment="Center" />
                                                <TextBox x:Name="HeaderSearchBox"
                                                         Grid.Column="1"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{DynamicResource Brush900}"
                                                         FontSize="11"
                                                         Padding="0,2"
                                                         AutomationProperties.Name="Поиск одежды"
                                                         VerticalContentAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Поиск одежды..."
                                                           Foreground="{DynamicResource Brush400}"
                                                           FontSize="11"
                                                           Margin="2,0,0,0"
                                                           VerticalAlignment="Center"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text.Length, ElementName=HeaderSearchBox, FallbackValue=0}" Value="0">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Background="{DynamicResource AccentDimBrush}"
                                                CornerRadius="9"
                                                Padding="8,3"
                                                VerticalAlignment="Center">
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding FilteredCount, ElementName=DrawableListControl}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Text.Length, ElementName=HeaderSearchBox, FallbackValue=0}" Value="0">
                                                                <Setter Property="Text" Value="{Binding Drawables.Count}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </Grid>
                                </Border>

                                <controls:DrawableList x:Name="DrawableListControl"
                                                       Grid.Row="1"
                                                       Margin="7"
                                                       ItemsSource="{Binding Drawables, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       SearchText="{Binding Text, ElementName=HeaderSearchBox, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                       DrawableListKeyDown="SelectedDrawable_KeyDown"
                                                       DrawableListSelectedValueChanged="SelectedDrawable_Changed" />
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <StackPanel Grid.Row="0"
                            Margin="18"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            IsHitTestVisible="True">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Addons.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <icons:MaterialIcon Kind="Hanger" Width="48" Height="48" Foreground="{DynamicResource Brush400}" HorizontalAlignment="Center" />
                    <TextBlock Text="Проект не открыт" Margin="0,12,0,4" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="Создайте проект или откройте набор одежды, чтобы начать редактирование"
                               Margin="0,0,0,14"
                               FontSize="11"
                               Foreground="{DynamicResource Brush600}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               MaxWidth="250" />
                    <Button Style="{StaticResource PanelButtonStyle}" Width="150" Click="EmptyProject_Click" Content="Перейти на главную" />
                </StackPanel>

                <Border Grid.Row="1"
                        IsEnabled="{Binding HasProject}"
                        Background="{DynamicResource Brush100}"
                        BorderBrush="{DynamicResource Brush250}"
                        BorderThickness="0,1,0,0"
                        Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>

                        <controls:CustomButton Grid.Column="0"
                                               Label="ЖЕНСКАЯ"
                                               SecondaryLabel="ОДЕЖДА"
                                               FontSize="11"
                                               MinHeight="44"
                                               FaIcon="Female"
                                               Tag="FEMALE"
                                               MyBtnClickEvent="Add_DrawableFile"
                                               Padding="8,0"
                                               CornerRadius="9"
                                               DropdownEnabled="True"
                                               Tooltip="Добавить женские YDD или выбрать папку"
                                               AutomationProperties.Name="Добавить женскую одежду">
                            <controls:CustomButton.DropdownContent>
                                <StackPanel>
                                    <Button Width="230"
                                                HorizontalAlignment="Stretch"
                                                Tag="FEMALE"
                                                Style="{StaticResource FolderMenuButtonStyle}"
                                                Click="Add_DrawableFolder"
                                                AutomationProperties.Name="Выбрать папку с женской одеждой">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <fa:IconBlock Grid.Column="0"
                                                              Icon="FolderOpen"
                                                              IconFont="Solid"
                                                              Width="17"
                                                              Height="17"
                                                              Margin="0,0,9,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Выбрать папку"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush800}" />
                                                <fa:IconBlock Grid.Column="2"
                                                              Icon="ChevronRight"
                                                              IconFont="Solid"
                                                              Width="13"
                                                              Height="13"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Brush500}" />
                                            </Grid>
                                        </Button>
                                </StackPanel>
                            </controls:CustomButton.DropdownContent>
                        </controls:CustomButton>

                        <controls:CustomButton Grid.Column="2"
                                               Label="МУЖСКАЯ"
                                               SecondaryLabel="ОДЕЖДА"
                                               FontSize="11"
                                               MinHeight="44"
                                               FaIcon="Male"
                                               Tag="MALE"
                                               MyBtnClickEvent="Add_DrawableFile"
                                               Padding="8,0"
                                               CornerRadius="9"
                                               DropdownEnabled="True"
                                               Tooltip="Добавить мужские YDD или выбрать папку"
                                               AutomationProperties.Name="Добавить мужскую одежду">
                            <controls:CustomButton.DropdownContent>
                                <StackPanel>
                                    <Button Width="230"
                                                HorizontalAlignment="Stretch"
                                                Tag="MALE"
                                                Style="{StaticResource FolderMenuButtonStyle}"
                                                Click="Add_DrawableFolder"
                                                AutomationProperties.Name="Выбрать папку с мужской одеждой">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <fa:IconBlock Grid.Column="0"
                                                              Icon="FolderOpen"
                                                              IconFont="Solid"
                                                              Width="17"
                                                              Height="17"
                                                              Margin="0,0,9,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="1"
                                                           Text="Выбрать папку"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush800}" />
                                                <fa:IconBlock Grid.Column="2"
                                                              Icon="ChevronRight"
                                                              IconFont="Solid"
                                                              Width="13"
                                                              Height="13"
                                                              Margin="8,0,0,0"
                                                              VerticalAlignment="Center"
                                                              Foreground="{DynamicResource Brush500}" />
                                            </Grid>
                                        </Button>
                                </StackPanel>
                            </controls:CustomButton.DropdownContent>
                        </controls:CustomButton>

                        <Button Grid.Column="4"
                                Style="{StaticResource DangerIconButtonStyle}"
                                Click="Delete_SelectedDrawable"
                                ToolTip="Удалить выбранную одежду"
                                AutomationProperties.Name="Удалить выбранную одежду">
                            <fa:IconBlock Icon="TrashCan"
                                          IconFont="Solid"
                                          Width="18"
                                          Height="18"
                                          Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <controls:SelectedDrawable x:Name="SelDrawable"
                                   Grid.Column="1"
                                   Grid.Row="0"
                                   TextureListSelectedValueChanged="SelectedDrawable_TextureChanged"
                                   SelectedDrawableUpdated="SelectedDrawable_Updated"
                                   SelectedDraw="{Binding SelectedAddon.SelectedDrawable}"
                                   SelectedTxt="{Binding SelectedAddon.SelectedTexture}" />

        <Border Grid.Column="1"
                Grid.Row="1"
                IsEnabled="{Binding HasProject}"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush250}"
                BorderThickness="0,1,0,0"
                Padding="18,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ProjectName, FallbackValue='Новый проект'}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush950}"
                               TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Foreground="{DynamicResource Brush600}" FontSize="10">
                            <Run Text="{Binding Addons.Count, Mode=OneWay}" />
                            <Run Text=" аддонов · " />
                            <Run Text="{Binding SelectedAddon.Drawables.Count, Mode=OneWay, FallbackValue=0}" />
                            <Run Text=" предметов" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="PreviewButton"
                            Style="{StaticResource PanelButtonStyle}"
                            Width="180"
                            Margin="0,0,10,0"
                            Click="Preview_Btn"
                            ToolTip="Открыть интерактивный 3D-просмотр">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Cube" IconFont="Solid" Width="18" Height="18" Margin="0,0,7,0" />
                            <TextBlock Text="3D-ПРОСМОТР" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource AccentPanelButtonStyle}"
                            Width="126"
                            Click="BuildResource_Btn">
                        <StackPanel Orientation="Horizontal">
                            <fa:IconBlock Icon="Box" IconFont="Solid" Width="18" Height="18" Margin="0,0,7,0" />
                            <TextBlock Text="СОБРАТЬ" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
