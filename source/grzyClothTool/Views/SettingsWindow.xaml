<UserControl x:Class="grzyClothTool.Views.SettingsWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:helpers="clr-namespace:grzyClothTool.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1280"
             d:Background="{DynamicResource Brush50}">
    <UserControl.Resources>
        <Style x:Key="SettingsCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Brush100}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Brush200}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="26" ShadowDepth="5" Opacity="0.08" Color="Black" />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush950}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <Style x:Key="SettingsDescription" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Brush500}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="ThemeCardList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <Style x:Key="ThemeCardItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ThemeCardBorder"
                                Background="{DynamicResource Brush75}"
                                BorderBrush="{DynamicResource Brush200}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThemeCardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThemeCardBorder" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ThemeCardBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="ThemeCardBorder" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ThemeCardTemplate">
            <Grid Width="212" Height="80">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="7" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{Binding AccentBrush}" CornerRadius="13,0,0,13" />
                <StackPanel Grid.Column="1" Margin="14,11,11,9">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="9" Height="9" Fill="{Binding AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocalizedName}" Margin="8,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Brush950}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LocalizedDescription}" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource Brush500}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Brush50}">
        <Grid.RowDefinitions>
            <RowDefinition Height="84" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="28,12,28,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0" Click="BackButton_Click" ToolTip="Вернуться в редактор"
                    Background="Transparent" BorderThickness="0" Padding="4" MinWidth="112" Height="42">
                <StackPanel Orientation="Horizontal">
                    <icons:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" Foreground="{DynamicResource AccentBrush}" />
                    <TextBlock Text="Назад" Margin="8,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                </StackPanel>
            </Button>

            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Настройки" FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource Brush950}" />
                <TextBlock Text="Пути, качество и оформление редактора" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource Brush500}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Padding="13,8" Background="{DynamicResource Brush100}" BorderBrush="{DynamicResource Brush200}" BorderThickness="1" CornerRadius="12">
                    <StackPanel Orientation="Horizontal">
                        <icons:MaterialIcon Kind="PaletteOutline" Width="18" Height="18" Foreground="{Binding SelectedTheme.AccentBrush}" />
                        <StackPanel Margin="9,0,0,0">
                            <TextBlock Text="Текущая тема" FontSize="10" Foreground="{DynamicResource Brush500}" />
                            <TextBlock Text="{Binding SelectedTheme.LocalizedName}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush950}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border MinWidth="190"
                        Margin="10,0,0,0"
                        Padding="12,6"
                        Background="{DynamicResource Brush100}"
                        BorderBrush="{DynamicResource Brush200}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="Translate"
                                                 Width="14"
                                                 Height="14"
                                                 Margin="0,0,5,0"
                                                 Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Язык" FontSize="10" Foreground="{DynamicResource Brush500}" />
                        </StackPanel>
                        <ComboBox Width="170"
                                  Height="36"
                                  MinHeight="36"
                                  Margin="0,4,0,0"
                                  Padding="10,0"
                                  VerticalContentAlignment="Center"
                                  ItemsSource="{Binding AvailableLanguages}"
                                  SelectedItem="{Binding SelectedLanguage, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  AutomationProperties.Name="Язык интерфейса"
                                  AutomationProperties.HelpText="Выберите язык интерфейса" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <ScrollViewer x:Name="SettingsScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Loaded="SettingsScrollViewer_Loaded">
            <Grid Margin="28,8,28,32" MaxWidth="1320" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource SettingsCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="TuneVariant" Width="21" Height="21" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Проверка качества" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock Text="Ограничения помогают находить проблемные модели и текстуры до сборки ресурса." Margin="0,8,0,18" FontSize="12" Foreground="{DynamicResource Brush500}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Высокий LOD" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Text="{Binding Path=PolygonLimitHigh, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Высокий LOD" />
                                <TextBlock Text="Лимит полигонов для верхнего уровня детализации." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Средний LOD" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Text="{Binding Path=PolygonLimitMed, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Средний LOD" />
                                <TextBlock Text="Лимит полигонов для среднего уровня детализации." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Низкий LOD" Style="{StaticResource SettingsFieldLabel}" />
                                <TextBox Text="{Binding Path=PolygonLimitLow, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Низкий LOD" />
                                <TextBlock Text="Лимит полигонов для нижнего уровня детализации." Style="{StaticResource SettingsDescription}" />
                            </StackPanel>
                        </Grid>

                        <Border Height="1" Background="{DynamicResource Brush300}" Margin="0,20,0,18" />
                        <TextBlock Text="Максимальное разрешение текстур" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="Если размер изображения превышает лимит, редактор покажет предупреждение." Margin="0,5,0,14" FontSize="11" Foreground="{DynamicResource Brush500}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Diffuse" Style="{StaticResource SettingsFieldLabel}" />
                                <ComboBox ItemsSource="{Binding TextureResolutionOptions}"
                                          SelectedItem="{Binding Path=TextureResolutionLimitDiffuse, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}"
                                          AutomationProperties.Name="Разрешение diffuse-текстуры" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Normal" Style="{StaticResource SettingsFieldLabel}" />
                                <ComboBox ItemsSource="{Binding TextureResolutionOptions}"
                                          SelectedItem="{Binding Path=TextureResolutionLimitNormal, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}"
                                          AutomationProperties.Name="Разрешение normal-текстуры" />
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="Specular" Style="{StaticResource SettingsFieldLabel}" />
                                <ComboBox ItemsSource="{Binding TextureResolutionOptions}"
                                          SelectedItem="{Binding Path=TextureResolutionLimitSpecular, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}"
                                          AutomationProperties.Name="Разрешение specular-текстуры" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1" Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.05*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="0.95*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="FolderOutline" Width="21" Height="21" Foreground="{DynamicResource SecondaryBrush}" />
                                <TextBlock Text="Рабочие папки" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>

                            <TextBlock Text="Папка проектов" Margin="0,20,0,7" Style="{StaticResource SettingsFieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding MainProjectsFolder, Mode=OneWay}" ToolTip="{Binding MainProjectsFolder}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="13,0" Height="36" Click="MainProjectsFolder_Click" Content="Изменить" />
                            </Grid>
                            <TextBlock Text="Все автосохранения и файлы проектов будут храниться здесь." Style="{StaticResource SettingsDescription}" />

                            <TextBlock Text="Папка GTA V" Margin="0,20,0,7" Style="{StaticResource SettingsFieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" IsReadOnly="True" Text="{Binding GTAVPath, Mode=OneWay}" ToolTip="{Binding GTAVPath}" />
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="13,0" Height="36" Click="GTAVPath_Click" Content="Изменить" />
                            </Grid>
                            <TextBlock Text="Нужна для 3D-просмотра одежды и проверки моделей." Style="{StaticResource SettingsDescription}" />

                            <Border Height="1" Background="{DynamicResource Brush300}" Margin="0,20,0,14" />
                            <TextBlock Text="Поведение редактора" FontSize="13" FontWeight="SemiBold" />
                            <CheckBox Margin="0,14,0,0" Content="Показывать путь выбранного элемента одежды" Foreground="{DynamicResource Brush800}" IsChecked="{Binding Path=DisplaySelectedDrawablePath, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}" />
                            <CheckBox Margin="0,10,0,0" Content="Автоматически удалять связанные файлы" Foreground="{DynamicResource Brush800}" IsChecked="{Binding Path=AutoDeleteFiles, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}" Click="AutoDelete_Click" />
                            <CheckBox Margin="0,10,0,0" Content="Помечать новые элементы одежды" Foreground="{DynamicResource Brush800}" IsChecked="{Binding Path=MarkNewDrawables, Source={x:Static helpers:SettingsHelper.Instance}, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource SettingsCard}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <icons:MaterialIcon Kind="BrushOutline" Width="21" Height="21" Foreground="{Binding SelectedTheme.AccentBrush}" />
                                <TextBlock Text="Оформление" Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="Выберите настроение редактора. Тема сохраняется автоматически." Margin="0,8,0,16" FontSize="12" Foreground="{DynamicResource Brush500}" TextWrapping="Wrap" />
                            <ListBox ItemsSource="{Binding AvailableThemes}"
                                     SelectedItem="{Binding SelectedTheme, Mode=TwoWay}"
                                     ItemTemplate="{StaticResource ThemeCardTemplate}"
                                     ItemContainerStyle="{StaticResource ThemeCardItem}"
                                     Style="{StaticResource ThemeCardList}"
                                     MaxHeight="350">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                            </ListBox>
                            <Border Margin="0,8,0,0" Padding="12,9" Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="10">
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedTheme.LocalizedName}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="{Binding SelectedTheme.LocalizedDescription}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Brush700}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Margin="28,0"
                Padding="0,7"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush300}"
                BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <fa:IconBlock Icon="Heart"
                              IconFont="Solid"
                              Width="13"
                              Height="13"
                              Foreground="{DynamicResource AccentBrush}" />
                <TextBlock Text="© 2026 MeX · ПО переделал MeX под чутким руководством Evelentdev"
                           Margin="7,0,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Brush500}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
