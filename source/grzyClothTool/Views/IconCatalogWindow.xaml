<Window x:Class="grzyClothTool.Views.IconCatalogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="Каталог иконок"
        Height="660"
        Width="900"
        MinHeight="420"
        MinWidth="560"
        MaxHeight="1000"
        MaxWidth="1600"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Brush50}"
        Foreground="{DynamicResource Brush950}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Width="42" Height="42"
                    Background="{DynamicResource AccentBrush}"
                    CornerRadius="12"
                    VerticalAlignment="Center">
                <icons:MaterialIcon Kind="ShapeOutline" Width="24" Height="24" Foreground="{DynamicResource OnPrimaryBrush}" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Material Icons"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush900}" />
                <TextBlock Text="Кликните по иконке, чтобы скопировать разметку"
                           FontSize="11"
                           Margin="0,3,0,0"
                           Foreground="{DynamicResource Brush500}" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Размер" Margin="0,0,8,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Brush600}" />
                <ComboBox x:Name="SizeComboBox" Width="86" SelectionChanged="SizeComboBox_SelectionChanged"
                          AutomationProperties.Name="Размер иконки">
                    <ComboBoxItem Content="16 px" Tag="16" />
                    <ComboBoxItem Content="20 px" Tag="20" IsSelected="True" />
                    <ComboBoxItem Content="24 px" Tag="24" />
                    <ComboBoxItem Content="32 px" Tag="32" />
                    <ComboBoxItem Content="48 px" Tag="48" />
                </ComboBox>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <TextBox x:Name="SearchBox"
                         Padding="38,8,12,8"
                         MinHeight="40"
                         TextChanged="SearchBox_TextChanged"
                         AutomationProperties.Name="Поиск иконки"
                         AutomationProperties.HelpText="Фильтр по названию иконки" />
                <icons:MaterialIcon Kind="Magnify" Width="20" Height="20"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Foreground="{DynamicResource Brush500}"
                                    IsHitTestVisible="False" />
            </Grid>

            <Border Grid.Column="1"
                    Margin="12,0,0,0"
                    Padding="14,0"
                    Background="{DynamicResource Brush150}"
                    BorderBrush="{DynamicResource Brush200}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource RadiusMd}"
                    MinWidth="150">
                <TextBlock x:Name="CountText"
                           Text="Иконок: 0"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource Brush700}" />
            </Border>
        </Grid>

        <!-- Icon grid -->
        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Background="{DynamicResource Brush100}"
                BorderBrush="{DynamicResource Brush200}"
                BorderThickness="1"
                CornerRadius="{StaticResource RadiusXl}">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="IconItems" Margin="10">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="104" Height="96"
                                        Margin="4"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="IconButton_Click"
                                        Tag="{Binding}"
                                        ToolTip="{Binding ToolTip}"
                                        AutomationProperties.Name="{Binding Name}">
                                    <StackPanel VerticalAlignment="Center">
                                        <icons:MaterialIcon Kind="{Binding Kind}"
                                                            Width="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Height="{Binding DataContext.IconSize, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            HorizontalAlignment="Center"
                                                            Foreground="{DynamicResource Brush800}" />
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0,8,0,0"
                                                   FontSize="9"
                                                   Foreground="{DynamicResource Brush600}"
                                                   TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="TileBorder"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="1"
                                                    CornerRadius="{StaticResource RadiusMd}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource AccentDimBrush}" />
                                                    <Setter TargetName="TileBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </Trigger>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource Brush150}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyState"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                    <icons:MaterialIcon Kind="MagnifyClose" Width="44" Height="44"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource Brush400}" />
                    <TextBlock x:Name="EmptyText"
                               Text="Ничего не найдено"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource Brush600}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Material Design Icons · Apache License 2.0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Brush500}" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock Text="Figma:"
                           VerticalAlignment="Center"
                           FontSize="11"
                           Foreground="{DynamicResource Brush500}" />
                <TextBlock Text="Material Design Icons"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}"
                           Cursor="Hand"
                           MouseLeftButtonUp="SourceLink_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="ToolTip" Value="https://www.figma.com/community/file/878585965681562011/material-design-icons" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="TextDecorations" Value="Underline" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
