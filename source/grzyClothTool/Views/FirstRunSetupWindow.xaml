<Window x:Class="grzyClothTool.Views.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:icons="clr-namespace:Material.Icons.WPF;assembly=Material.Icons.WPF"
        mc:Ignorable="d"
        Title="Добро пожаловать в KazanClothTool"
        Width="640"
        Height="520"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush50}"
        Foreground="{DynamicResource Brush950}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="SetupPrimaryButton" TargetType="Button">
            <Setter Property="MinWidth" Value="150" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OnPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Window.Resources>

    <Grid Margin="28,24,28,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Width="52" Height="52" Background="{DynamicResource AccentDimBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="15">
                <icons:MaterialIcon Kind="Hanger" Width="28" Height="28" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <StackPanel Grid.Column="1" Margin="15,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Добро пожаловать в KazanClothTool!" FontSize="23" FontWeight="SemiBold" />
                <TextBlock Text="Первоначальная настройка редактора" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource Brush500}" />
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="Главная папка проектов" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource Brush600}" TextWrapping="Wrap" LineHeight="19">
                    Выберите родительскую папку, в которой будут храниться все автономные проекты KazanClothTool.
                </TextBlock>
                <TextBlock Margin="0,5,0,0" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Brush500}" TextWrapping="Wrap">
                    Не выбирайте папку конкретного проекта — в этой папке можно будет создать несколько проектов.
                </TextBlock>

                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderPathTextBox"
                             Grid.Column="0"
                             Height="42"
                             Padding="12,0"
                             FontSize="12"
                             IsReadOnly="True"
                             VerticalContentAlignment="Center"
                             ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button x:Name="BrowseButton"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Padding="17,0"
                            Height="42"
                            Content="Обзор..."
                            Click="BrowseButton_Click"
                            ToolTip="Выбрать папку проектов" />
                </Grid>

                <TextBlock x:Name="ValidationMessage"
                           Margin="2,8,0,0"
                           FontSize="11"
                           Foreground="{DynamicResource DangerBrush}"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />

                <Border Margin="0,22,0,4" Padding="16" Background="{DynamicResource Brush75}" BorderBrush="{DynamicResource Brush300}" BorderThickness="1" CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <icons:MaterialIcon Kind="InformationOutline" Width="18" Height="18" Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="Важная информация" Margin="9,0,0,0" FontSize="13" FontWeight="SemiBold" />
                        </StackPanel>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock FontSize="11" Foreground="{DynamicResource Brush600}" TextWrapping="Wrap" Text="• Настройка сохраняется в профиле пользователя и не исчезает при обновлении приложения." />
                            <TextBlock Margin="0,5,0,0" FontSize="11" Foreground="{DynamicResource Brush600}" TextWrapping="Wrap" Text="• Главную папку можно изменить позже в разделе «Настройки»." />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource Brush500}" Text="Проекты и автосохранения будут храниться в выбранной папке." TextWrapping="Wrap" />
            <Button x:Name="ContinueButton"
                    Grid.Column="1"
                    Style="{StaticResource SetupPrimaryButton}"
                    Content="Продолжить"
                    Click="ContinueButton_Click"
                    IsEnabled="False" />
        </Grid>
    </Grid>
</Window>
