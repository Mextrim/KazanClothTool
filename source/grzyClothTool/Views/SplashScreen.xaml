<Window x:Class="grzyClothTool.Views.SplashScreen"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="KazanClothTool"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Height="420"
        Width="440"
        Background="Transparent">
    <Border Margin="8"
            Background="{DynamicResource Brush100}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1"
            CornerRadius="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="Black" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="4" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="23,23,0,0" />

            <Grid Grid.Row="1" Margin="32,20,32,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Width="164"
                        Height="164"
                        HorizontalAlignment="Center"
                        Background="{DynamicResource Brush50}"
                        BorderBrush="{DynamicResource Brush300}"
                        BorderThickness="1"
                        CornerRadius="42">
                    <Image Width="142" Source="pack://application:,,,/Resources/KazanClothTool.png" />
                </Border>

                <TextBlock Grid.Row="1"
                           Margin="0,18,0,0"
                           Text="KazanClothTool"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           FontSize="30"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush950}"
                           HorizontalAlignment="Center" />

                <TextBlock Grid.Row="2"
                           Margin="0,5,0,0"
                           Text="3D-редактор одежды и текстур"
                           FontSize="13"
                           Foreground="{DynamicResource Brush600}"
                           HorizontalAlignment="Center" />
            </Grid>

            <Grid Grid.Row="2" Margin="30,0,30,26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="12,8"
                        Background="{DynamicResource Brush75}"
                        BorderBrush="{DynamicResource Brush300}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <TextBlock x:Name="updateTextBox"
                               Text="Подготовка редактора..."
                               FontSize="12"
                               Foreground="{DynamicResource Brush800}"
                               HorizontalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <ProgressBar Grid.Row="1"
                             Margin="0,14,0,0"
                             Height="4"
                             Background="{DynamicResource Brush250}"
                             Foreground="{DynamicResource AccentBrush}"
                             BorderThickness="0"
                             IsIndeterminate="True" />
            </Grid>
        </Grid>
    </Border>
</Window>
