/* Shared Kazan Cloth Tool Qt 6 stylesheet.
   ThemeManager replaces the color tokens before applying this file. */

QWidget {
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 14px;
    background-color: {{BACKGROUND}};
    color: {{TEXT}};
}

QMainWindow,
QDialog {
    background-color: {{BACKGROUND}};
}

QWidget#centralWidget {
    background-color: {{BACKGROUND}};
}

QFrame#topBar {
    background-color: {{SURFACE}};
    border-bottom: 1px solid {{BORDER}};
}

QFrame#navigationBar {
    background-color: transparent;
}

QLabel#brandMark {
    background-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
    border-radius: 12px;
    font-size: 14px;
    font-weight: 700;
}

QLabel#brandTitle {
    color: {{TEXT}};
    font-size: 18px;
    font-weight: 700;
}

QLabel#brandSubtitle,
QLabel#pageSubtitle,
QLabel#mutedLabel,
QLabel#emptyText,
QLabel#emptyHint {
    color: {{MUTED}};
}

QLabel#buildBadge {
    color: {{MUTED}};
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1px;
    padding: 7px 10px;
    border: 1px solid {{BORDER}};
    border-radius: 8px;
}

QPushButton {
    min-height: 20px;
    padding: 8px 15px;
    border: 1px solid {{BORDER}};
    border-radius: 9px;
    background-color: {{SURFACE_ALT}};
    color: {{TEXT}};
    font-weight: 600;
}

QPushButton:hover {
    background-color: {{ACCENT_HOVER}};
    border-color: {{ACCENT_HOVER}};
    color: {{ACCENT_TEXT}};
}

QPushButton:pressed {
    background-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QPushButton:disabled {
    background-color: {{SURFACE_ALT}};
    border-color: {{BORDER}};
    color: {{MUTED}};
}

QPushButton#primaryButton {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QPushButton#primaryButton:hover {
    background-color: {{ACCENT_HOVER}};
    border-color: {{ACCENT_HOVER}};
}

QPushButton#navButton {
    min-height: 18px;
    padding: 7px 16px;
    background-color: transparent;
    border-color: transparent;
    color: {{MUTED}};
    font-weight: 600;
}

QPushButton#navButton:hover {
    background-color: {{SURFACE_ALT}};
    border-color: {{BORDER}};
    color: {{TEXT}};
}

QPushButton#navButton:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QPushButton#dangerButton {
    background-color: transparent;
    border-color: {{DANGER}};
    color: {{DANGER}};
}

QPushButton#dangerButton:hover {
    background-color: {{DANGER}};
    border-color: {{DANGER}};
    color: {{ACCENT_TEXT}};
}

QPushButton#dangerButton:disabled {
    background-color: transparent;
    border-color: {{BORDER}};
    color: {{MUTED}};
}

QPushButton#linkButton {
    min-height: 18px;
    padding: 5px 8px;
    background-color: transparent;
    border-color: transparent;
    color: {{ACCENT}};
}

QPushButton#linkButton:hover {
    background-color: {{SURFACE_ALT}};
    border-color: {{BORDER}};
    color: {{ACCENT_HOVER}};
}

QToolButton {
    min-height: 20px;
    padding: 8px 13px;
    border: 1px solid {{BORDER}};
    border-radius: 9px;
    background-color: {{SURFACE_ALT}};
    color: {{TEXT}};
    font-weight: 600;
}

QToolButton:hover {
    background-color: {{ACCENT_HOVER}};
    border-color: {{ACCENT_HOVER}};
    color: {{ACCENT_TEXT}};
}

QToolButton#folderButton::menu-indicator {
    image: none;
    width: 10px;
}

QLabel#pageTitle {
    color: {{TEXT}};
    font-size: 30px;
    font-weight: 700;
}

QLabel#sectionTitle {
    color: {{TEXT}};
    font-size: 16px;
    font-weight: 700;
}

QLabel#projectBar {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 12px;
}

QLabel#projectPath {
    color: {{TEXT}};
    font-weight: 600;
}

QFrame#card,
QFrame#emptyState {
    background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 16px;
}

QFrame#splitActionButton {
    background-color: {{SURFACE_ALT}};
    border: 1px solid {{BORDER}};
    border-radius: 12px;
}

QPushButton#splitLeft,
QPushButton#splitRight {
    min-height: 24px;
    padding: 8px 14px;
    border: 1px solid transparent;
    border-radius: 8px;
    background-color: transparent;
    color: {{MUTED}};
    font-size: 13px;
    font-weight: 700;
}

QPushButton#splitLeft:hover,
QPushButton#splitRight:hover {
    background-color: {{SURFACE}};
    border-color: {{BORDER}};
    color: {{TEXT}};
}

QPushButton#splitLeft:checked,
QPushButton#splitRight:checked {
    background-color: {{ACCENT}};
    border-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QLabel#countBadge {
    color: {{MUTED}};
    background-color: {{SURFACE_ALT}};
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    padding: 5px 8px;
    font-size: 12px;
}

QLabel#emptyTitle {
    color: {{TEXT}};
    font-size: 20px;
    font-weight: 700;
}

QLabel#emptyRecent {
    color: {{MUTED}};
    background-color: {{SURFACE}};
    border: 1px dashed {{BORDER}};
    border-radius: 14px;
    padding: 20px;
}

QLabel#statusLabel {
    color: {{MUTED}};
    padding: 2px 1px;
}

QLabel#statusLabel[isError="true"] {
    color: {{DANGER}};
}

QListWidget {
    background-color: {{SURFACE}};
    alternate-background-color: {{SURFACE}};
    border: 1px solid {{BORDER}};
    border-radius: 12px;
    padding: 5px;
    outline: none;
}

QListWidget::item {
    min-height: 38px;
    padding: 7px 10px;
    border-radius: 7px;
    color: {{TEXT}};
}

QListWidget::item:hover {
    background-color: {{SURFACE_ALT}};
}

QListWidget::item:selected {
    background-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QComboBox,
QLineEdit {
    min-height: 22px;
    padding: 7px 10px;
    border: 1px solid {{BORDER}};
    border-radius: 8px;
    background-color: {{SURFACE_ALT}};
    color: {{TEXT}};
    selection-background-color: {{ACCENT}};
    selection-color: {{ACCENT_TEXT}};
}

QComboBox:hover,
QLineEdit:hover {
    border-color: {{ACCENT}};
}

QComboBox:focus,
QLineEdit:focus {
    border-color: {{ACCENT}};
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    background-color: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    selection-background-color: {{ACCENT}};
    selection-color: {{ACCENT_TEXT}};
    padding: 4px;
}

QMenu {
    background-color: {{SURFACE}};
    color: {{TEXT}};
    border: 1px solid {{BORDER}};
    padding: 5px;
}

QMenu::item {
    padding: 7px 26px 7px 10px;
    border-radius: 6px;
}

QMenu::item:selected {
    background-color: {{ACCENT}};
    color: {{ACCENT_TEXT}};
}

QMenu::separator {
    height: 1px;
    background: {{BORDER}};
    margin: 4px 6px;
}

QScrollBar:vertical {
    background: {{SURFACE}};
    width: 10px;
    margin: 2px;
    border: none;
}

QScrollBar::handle:vertical {
    background: {{BORDER}};
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QStatusBar {
    background: {{SURFACE}};
    color: {{MUTED}};
}

QToolTip {
    color: {{TEXT}};
    background-color: {{SURFACE}};
    border: 1px solid {{ACCENT}};
    padding: 5px;
}
